__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.env
.DS_Store
.pdf_cache/

# Local Claude Code state (machine/session harness, not project content)
.claude/settings.local.json

# Per-fork build scaffolding (one-shot scripts used to generate registry writes
# for a single fork; the canonical artifact is the resulting JSON in data/,
# not the script that produced it)
scripts/

# Cached bulk source files pulled by collectors (re-downloadable build artifacts,
# not detection output). The detection output under collectors/state/ (the candidate
# queue, match records, and last-seen diffs) IS committed and auditable.
collectors/state/gsa-cache/*
!collectors/state/gsa-cache/.gitkeep

# Transit handoff and instruction artifacts at repo root
# Working-process trail. Canonical methodology in docs/methodology.md;
# canonical project instructions in PROJECT.md.
/connected-procurement-SKILL.md
/connected-procurement-code-handoff.md
/connected-procurement-handoff*.md
/connected-procurement-project-instructions*.md
/connected-procurement-registry-schema-spec.md
/fork-b-section-2-replacement.md

# Working notes — never repo artifacts. Un-anchored so docs/<dir>/ is caught too.
docs/handoffs/
docs/backlog/
docs/triage/
docs/reviews/
docs/archive/*-instructions*.md
docs/references/*-watchlist.md
docs/references/*-research-target.md
docs/references/*-evidence-worksheet.md
docs/drafts/schema-proposal-*
**/*-project-instructions*.md

!web/scripts/
!web/scripts/**
